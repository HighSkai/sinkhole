# Serve the static Sinkhole build with Caddy.
#   docker:  see ../Dockerfile (copies dist/ to /srv)
#   bare:    caddy run --config deploy/Caddyfile   (after `npm run build`, with root pointing at dist/)

:80 {
	root * /srv

	# Hashed assets never change: cache forever.
	@hashed path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	# The HTML shell must always be revalidated so new builds are picked up.
	@shell path / /index.html
	header @shell Cache-Control "no-cache"

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Frame-Options DENY
		-Server
	}

	# Real backend on the same origin (WebSocket upgrades are proxied automatically):
	# reverse_proxy /api/* 127.0.0.1:8053

	try_files {path} /index.html
	encode zstd gzip
	file_server {
		# serve the .br / .gz files produced by `npm run build`
		precompressed br gzip
	}
}

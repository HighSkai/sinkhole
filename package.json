{
  "name": "sinkhole",
  "private": true,
  "version": "1.0.0",
  "description": "A self-hosted, network-wide DNS ad blocker dashboard built as a node-based visual pipeline.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:pages": "vite build --base /sinkhole/",
    "preview": "vite preview --host",
    "preview:pages": "vite preview --base /sinkhole/",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "size": "node scripts/size.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@lucide/svelte": "^1.80.0",
    "@xyflow/svelte": "^2.0.3"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.2",
    "@tailwindcss/vite": "^4.3.5",
    "@tsconfig/svelte": "^5.0.9",
    "svelte": "^5.59.2",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "vite": "^8.3.8"
  }
}
